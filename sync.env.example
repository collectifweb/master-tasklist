# Copier vers ~/.config/oree/sync.env (jamais dans le dépôt).
# Valeurs fictives : adresses réservées RFC 5737 / RFC 2606.
TASKS_DIR="$HOME/oree/tasks"
# De préférence un alias défini dans ~/.ssh/config :
TASKS_REMOTE="oree-prod"
# ...ou, à défaut :
# TASKS_REMOTE="usr00000@203.0.113.10"
# TASKS_SSH_PORT="22"
# TASKS_SSH_KEY="$HOME/.ssh/id_ed25519_exemple"
TASKS_REMOTE_FILE="/chemin/distant/todo/tasks.json"

